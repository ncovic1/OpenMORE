<?xml version="1.0"?>
<launch>
  <include file="$(find replanners_bench_cells)/launch/load_cell_spatial_18dof.launch"/>

  <rosparam command="load" file="$(find replanners_benchmark)/config/spatial_Ndof.yaml"/>

  <node pkg="replanners_benchmark"
        name="replanners_benchmark_random"
        type="replanners_benchmark_random"
        output="screen"
        launch-prefix="gdb -ex run --args">
  </node>

</launch>
